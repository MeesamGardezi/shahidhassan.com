<section class="section" id="projects">
  <div class="section-header reveal">
    <div class="section-label">Featured projects</div>
    <h2 class="section-title">Landmark <em>work</em></h2>
  </div>

  <div class="projects-bento">
    <% projects.forEach(function(p, i) { %>
    <div class="proj-card<%= p.featured ? ' featured' : '' %> reveal" data-delay="<%= i * 80 %>">
      <div class="proj-num">0<%= i + 1 %></div>
      <div class="proj-location"><%= p.location %></div>
      <h3 class="proj-title"><%= p.title %></h3>
      <p class="proj-desc"><%= p.desc %></p>
      <div class="proj-value"><%= p.value %></div>
    </div>
    <% }) %>
  </div>
</section>
