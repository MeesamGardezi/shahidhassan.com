<section class="hero" id="top">
  <div class="hero-inner">

    <!-- LEFT: Name + bio + CTAs -->
    <div class="hero-left">
      <div class="hero-eyebrow"><%= site.role %></div>

      <h1 class="hero-name">
        <span class="hero-first"><%= site.name.first %></span>
        <span class="hero-last"><%= site.name.last %></span>
      </h1>

      <p class="hero-creds"><%= site.credentials %></p>
      <p class="hero-bio"><%= site.bio %></p>

      <div class="hero-ctas">
        <a href="#contact" class="btn-primary">Get in touch →</a>
        <a href="#projects" class="btn-outline">View projects</a>
      </div>
    </div>

    <!-- RIGHT: Stats card -->
    <div class="hero-card">
      <div class="stat-row">
        <div class="stat-num" data-count="18" data-suffix="+">18+</div>
        <div class="stat-lbl">Years of experience</div>
      </div>
      <div class="stat-row">
        <div class="stat-num amber">AED 2B+</div>
        <div class="stat-lbl">Portfolio delivered</div>
      </div>
      <div class="stat-row">
        <div class="stat-num sm">UAE · Oman · Pakistan</div>
        <div class="stat-lbl">Markets</div>
      </div>
      <p class="hero-card-quote">"Procurement, contracts, and project delivery — done right, from day one."</p>
    </div>

  </div>
</section>
