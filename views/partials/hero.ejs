<section class="hero" id="top">
  <div class="hero-orb hero-orb-1"></div>
  <div class="hero-orb hero-orb-2"></div>

  <div class="hero-inner">
    <div class="hero-label"><%= site.role %></div>

    <h1 class="hero-name">
      <span class="hero-first"><%= site.name.first %></span>
      <span class="hero-last"><%= site.name.last %></span>
    </h1>

    <div class="hero-credentials"><%= site.credentials %></div>

    <p class="hero-bio"><%= site.bio %></p>

    <div class="hero-ctas">
      <a href="#contact" class="btn-primary">Get in touch <span class="btn-arrow">→</span></a>
      <a href="#projects" class="btn-outline">View projects</a>
    </div>

    <div class="hero-stats">
      <div class="stat">
        <span class="stat-num" data-count="18" data-suffix="+">18+</span>
        <span class="stat-label">Years of experience</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-num gold">AED 2B+</span>
        <span class="stat-label">Portfolio delivered</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-num">UAE · Oman · Pakistan</span>
        <span class="stat-label">Markets</span>
      </div>
    </div>
  </div>

  <a href="#projects" class="scroll-cue" aria-label="Scroll down">
    <span class="scroll-cue-line"></span>
  </a>
</section>
