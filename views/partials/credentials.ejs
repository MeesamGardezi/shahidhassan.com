<section class="section-full alt-bg" id="credentials">
  <div class="section-inner section">
    <div class="section-header reveal">
      <div class="section-label">Education & qualifications</div>
      <h2 class="section-title"><em>Credentials</em></h2>
    </div>

    <div class="creds-grid">
      <% credentials.forEach(function(c, i) { %>
      <div class="cred-card<%= c.highlight ? ' highlight' : '' %> reveal" data-delay="<%= i * 80 %>">
        <div class="cred-year"><%= c.year %></div>
        <div class="cred-degree"><%= c.degree %></div>
        <div class="cred-school"><%= c.school %></div>
        <p class="cred-note"><%= c.note %></p>
      </div>
      <% }) %>
    </div>

    <div class="memberships-card reveal" data-delay="200">
      <div class="memberships-label">Professional memberships & certifications</div>
      <div class="tag-list">
        <% memberships.forEach(function(m) { %>
        <span class="tag"><%= m %></span>
        <% }) %>
      </div>
    </div>
  </div>
</section>
