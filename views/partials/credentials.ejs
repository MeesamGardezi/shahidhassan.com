<div class="section-alt" id="credentials">
  <div class="section-inner">
    <div class="sec-hdr reveal">
      <div class="sec-eyebrow">Education & qualifications</div>
      <h2 class="sec-title"><em>Credentials</em></h2>
    </div>

    <div class="creds-grid">
      <% credentials.forEach(function(c, i) { %>
      <div class="cred<%= c.highlight ? ' hl' : '' %> reveal" data-delay="<%= i * 90 %>">
        <div class="cred-yr"><%= c.year %></div>
        <div class="cred-deg"><%= c.degree %></div>
        <div class="cred-sch"><%= c.school %></div>
        <p class="cred-note"><%= c.note %></p>
      </div>
      <% }) %>
    </div>

    <div class="memberships reveal" data-delay="150">
      <div class="mem-title">Professional memberships & certifications</div>
      <div class="tags">
        <% memberships.forEach(function(m) { %>
        <span class="tag"><%= m %></span>
        <% }) %>
      </div>
    </div>
  </div>
</div>
