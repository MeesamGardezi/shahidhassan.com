<section class="section" id="contact">
  <div class="section-header reveal">
    <div class="section-label">Get in touch</div>
    <h2 class="section-title">Let's <em>connect</em></h2>
  </div>

  <div class="contact-wrap">
    <div class="contact-left reveal">
      <p class="contact-sub">Having delivered over AED 2 billion in construction value across the GCC, I'm now looking for my next challenge — senior procurement, contracts, or project management leadership roles globally.</p>

      <div class="contact-links">
        <a href="mailto:<%= site.email %>" class="contact-link">
          <div class="contact-link-icon">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M2 4l6 4.5L14 4M2 4h12v8H2V4z" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span><%= site.email %></span>
        </a>

        <% site.phone.forEach(function(p) { %>
        <a href="tel:<%= p.number %>" class="contact-link">
          <div class="contact-link-icon">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 2h3l1.5 3.5L6 7a10 10 0 003 3l1.5-1.5L14 10v3a1 1 0 01-1 1A11 11 0 012 3a1 1 0 011-1z" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span><%= p.display %> <span class="contact-link-label">— <%= p.label %></span></span>
        </a>
        <% }) %>
      </div>
    </div>

    <div class="contact-form-wrap reveal" data-delay="100">
      <div class="form-title">Send a message</div>
      <p class="form-sub">Role, opportunity, or project inquiry — I'd love to hear from you.</p>

      <form class="contact-form" id="contact-form">
        <div class="form-row">
          <div class="form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" placeholder="Your name" required>
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="you@email.com" required>
          </div>
        </div>
        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" name="message" placeholder="Role, opportunity, or project details…" required></textarea>
        </div>
        <button type="submit" class="btn-primary btn-submit">Send message <span class="btn-arrow">→</span></button>
      </form>
    </div>
  </div>
</section>
