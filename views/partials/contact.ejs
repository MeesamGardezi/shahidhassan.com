<section class="section" id="contact">
  <div class="sec-hdr reveal">
    <div class="sec-eyebrow">Get in touch</div>
    <h2 class="sec-title">Let's <em>connect</em></h2>
  </div>

  <div class="contact-grid">
    <div class="reveal">
      <p class="contact-copy">Having delivered over AED 2 billion in construction value across the GCC, I'm now looking for my next challenge — senior procurement, contracts, or project management leadership roles globally.</p>

      <div class="contact-links">
        <a href="mailto:<%= site.email %>" class="clink">
          <div class="clink-ico">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M2 4.5l6 4 6-4M2 4h12v8H2V4z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span><%= site.email %></span>
        </a>

        <% site.phone.forEach(function(p) { %>
        <a href="tel:<%= p.number %>" class="clink">
          <div class="clink-ico">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 2h3l1.5 3.5-1.5 1.5a9 9 0 003 3l1.5-1.5L14 10v3a1 1 0 01-1 1A12 12 0 012 3a1 1 0 011-1z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span><%= p.display %> <span class="clink-sub">— <%= p.label %></span></span>
        </a>
        <% }) %>
      </div>
    </div>

    <div class="contact-form-box reveal" data-delay="100">
      <div class="form-hdg">Send a message</div>
      <p class="form-sub">Role, opportunity, or project inquiry — I'd love to hear from you.</p>

      <form id="contact-form">
        <div class="form-row">
          <div class="fgrp">
            <label for="cf-name">Name</label>
            <input type="text" id="cf-name" placeholder="Your name" required>
          </div>
          <div class="fgrp">
            <label for="cf-email">Email</label>
            <input type="email" id="cf-email" placeholder="you@email.com" required>
          </div>
        </div>
        <div class="fgrp">
          <label for="cf-msg">Message</label>
          <textarea id="cf-msg" placeholder="Role, opportunity, or project details…" required></textarea>
        </div>
        <button type="submit" class="btn-primary">Send message →</button>
      </form>
    </div>
  </div>
</section>
